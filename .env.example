# ========================================
# SERVER CONFIGURATION
# ========================================

# Port for the API server (REQUIRED)
PORT=5050

# Node environment (development, production)
NODE_ENV=development

# API Secret for authentication (REQUIRED)
# IMPORTANT: Generate a strong random secret for production
# You can generate one with: openssl rand -hex 32
API_SECRET=your_secure_api_secret_here_change_in_production

# ========================================
# SECURITY CONFIGURATION
# ========================================

# CORS allowed origins (comma-separated URLs)
# Use '*' for development only, specify exact origins in production
# Example: CORS_ORIGIN=https://yourdomain.com,https://app.yourdomain.com
CORS_ORIGIN=*

# Cache TTL in milliseconds (for trade history endpoint)
# Default: 60000 (60 seconds)
CACHE_TTL=60000~

# ========================================
# EXTENDED API CONFIGURATION (X10 Exchange)
# ========================================

# URL for the Extended API (X10 Exchange API)
EXTENDED_API_URL=https://api.x10.exchange

# API Key for authenticating with Extended API (REQUIRED)
# Get this from your X10 Exchange account
EXTENDED_API_KEY=your_extended_api_key_here

# Private key for signing transactions on Starknet (REQUIRED)
# IMPORTANT: Keep this secret and never commit it to version control
EXTENDED_PRIVATE_KEY=your_starknet_private_key_here

# ========================================
# STARKNET RPC CONFIGURATION
# ========================================

# URL for connecting to the Starknet network (REQUIRED)
# You can use public endpoints or services like Infura, Alchemy, or your own node
STARKNET_RPC_URL=https://starknet-mainnet.public.blastapi.io

# ========================================
# AI PROVIDER CONFIGURATION
# ========================================

# Choose ONE of the following AI providers
# The system will automatically detect which provider is configured

# Option 1: Anthropic (Claude)
# Get this from https://console.anthropic.com/
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Option 2: OpenAI (GPT)
# Get this from https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4-turbo-preview

# Option 3: Google (Gemini)
# Get this from https://makersuite.google.com/app/apikey
# GOOGLE_API_KEY=your_google_api_key_here
# GOOGLE_MODEL=gemini-pro

# ========================================
# WAR EXECUTION CONFIGURATION
# ========================================

# Time to wait between war cycles (in milliseconds)
WAR_CYCLE_TIMEOUT_MS=10000

# ========================================
# LANGSMITH CONFIGURATION (Optional)
# ========================================

# Enable LangSmith tracing for monitoring and debugging
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com/
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_PROJECT=your-project-name

# ========================================
# ADDITIONAL NOTES
# ========================================

# Note: Extended accounts, API keys, and AI model configurations can also be managed
# in the config/extended-war.config.json file. Please refer to that file for:
# - Extended API credentials (apiKey, privateKey, apiUrl)
# - AI Model configuration (provider, model name, API keys)
# - Multiple account setup
